# BGM — environment variables. Copy to .env.local for development; set the same
# names in Vercel for production. Never commit real values.

# --- Firebase client (public; used in the browser for sign-in) ---------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin (server only, secret) ------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Public URL used in e-mails / SMS (defaults to https://gymos.app in production)
APP_URL=https://gymos.app

# --- E-mail: either Resend or SMTP -------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=BGM <no-reply@gymos.app>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SUPPORT_EMAIL=support@gymos.app

# --- Razorpay ----------------------------------------------------------------
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- SMS (Twilio) ------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_PHONE_NUMBER=

# --- Internal secrets (generate long random strings) --------------------------
CRON_SECRET=
FIREBASE_WEBHOOK_SECRET=
