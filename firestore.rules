rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ---------------------------------------------------------------------
    // BGM reads and writes ALL application data through authorised Server
    // Actions that use the Firebase Admin SDK (which bypasses these rules).
    // The browser SDK is used for authentication only and never touches
    // Firestore, so direct client access is denied for every collection.
    //
    // This closes the door on anyone using the public web API key to read or
    // modify data directly: gym isolation and role checks cannot be bypassed
    // by talking to Firestore instead of the application.
    //
    // If a client-side listener is ever introduced, add a narrowly scoped
    // read rule for that collection here — never a wildcard.
    // ---------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
