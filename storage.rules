rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Profile photos are uploaded by the server (Admin SDK) after it has
    // verified the session, validated the image and written it to
    // profilePhotos/{uid}/…. They are read through tokenised download URLs,
    // which do not pass through these rules. No direct client access is needed.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
